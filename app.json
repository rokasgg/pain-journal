{
  "expo": {
    "name": "pain-journal",
    "slug": "pain-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "painjournal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.rokas.painjournal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rokas.painjournal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DDE0DD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0B1410"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-sharing",
      "expo-image",
      "expo-web-browser",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Pain Journal reads your sleep, steps and workouts to fill in your check-ins and compare activity with your pain. It never writes to Health.",
          "NSHealthUpdateUsageDescription": "Pain Journal only reads from Apple Health and never writes or changes your Health data.",
          "background": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pain Journal uses your photos to set your profile picture and to read exercise sheets from your physio.",
          "cameraPermission": "Pain Journal uses the camera to photograph exercise sheets from your physio. Photos aren't saved.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a333e4af-ce93-4a28-ac20-5b13c713192d"
      }
    },
    "locales": {
      "lt": "./locales/lt.json"
    }
  }
}
