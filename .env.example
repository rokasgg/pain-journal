# Used for local development (`expo start`). EAS builds instead pull these
# from the per-profile `env` blocks in eas.json (development/preview/production),
# each pointing at its own Supabase project.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# RevenueCat public iOS SDK key (Premium). Missing = purchases disabled,
# everything else works. Also add it to each eas.json profile's env.
# A Test Store key (test_…) simulates purchases without App Store Connect and
# only works in __DEV__ builds; release builds need the appl_… key.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-public-key
